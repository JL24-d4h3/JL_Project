Indexes:
    "content_pkey" PRIMARY KEY, btree (id)
    "content_file_hash_key" UNIQUE CONSTRAINT, btree (file_hash)
    "content_slug_key" UNIQUE CONSTRAINT, btree (slug)
    "idx_content_category" btree (category_id)
    "idx_content_created" btree (created_at DESC)
    "idx_content_etag" btree (etag) WHERE etag IS NOT NULL
    "idx_content_featured" btree (is_featured) WHERE is_featured = true AND deleted_at IS NULL
    "idx_content_hash" btree (file_hash)
    "idx_content_last_accessed" btree (last_accessed) WHERE deleted_at IS NULL
    "idx_content_priority" btree (priority)
    "idx_content_search" gin (to_tsvector('spanish'::regconfig, (COALESCE(title, ''::character varying)::text || ' '::text) || COALESCE(description, ''::text)))
    "idx_content_status" btree (status) WHERE deleted_at IS NULL
    "idx_content_title_trgm" gin (title gin_trgm_ops)
    "idx_content_type" btree (type)
Check constraints:
    "content_priority_check" CHECK (priority >= 1 AND priority <= 10)
    "content_status_check" CHECK (status::text = ANY (ARRAY['active'::character varying, 'archived'::character varying, 'processing'::character varying, 'failed'::character varying]::text[]))
    "content_type_check" CHECK (type::text = ANY (ARRAY['video'::character varying, 'pdf'::character varying, 'audio'::character varying, 'interactive'::character varying, 'image'::character varying, 'document'::character varying]::text[]))
Foreign-key constraints:
    "content_category_id_fkey" FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE SET NULL
    "content_created_by_fkey" FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE SET NULL
    "content_deleted_by_fkey" FOREIGN KEY (deleted_by) REFERENCES users(id) ON DELETE SET NULL
    "content_updated_by_fkey" FOREIGN KEY (updated_by) REFERENCES users(id) ON DELETE SET NULL
