# ============================================================
# Fase 2 — Jetson Orin NX 16GB  ← PLAN ORIGINAL
# Modelos: Llama-3.2-1B (draft) + Llama-3.1-8B (target)
# Speculative decoding γ=5
# ChromaDB: 100K chunks máximo
# Ingesta: realtime con semáforo estándar
# ============================================================

AI_PLATFORM=orin_nx_16gb

# Rutas de engines compilados
DRAFT_MODEL_DIR=/mnt/ssd/trt_engines/llama32-1b-int4
TARGET_MODEL_DIR=/mnt/ssd/trt_engines/llama31-8b-int4

# Modelos auxiliares
WHISPER_MODEL_DIR=/mnt/ssd/models/whisper
EMBED_MODEL_DIR=/mnt/ssd/models/embeddings

# Base de datos vectorial
CHROMADB_PATH=/mnt/ssd/chromadb_data

# Almacenamiento del CDN
STORAGE_PATH=/mnt/ssd/CDN/storage

# Red
CDN_BACKEND_URL=http://localhost:3000
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000

# Observabilidad
LOG_LEVEL=info
PROMETHEUS_PORT=9090
